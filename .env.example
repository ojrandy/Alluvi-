# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (MySQL/MariaDB on Namecheap cPanel) ---
DATABASE_URL=mysql://cpaneluser_alluvi:password@localhost:3306/cpaneluser_alluvi

# --- Admin auth ---
ADMIN_EMAIL=admin@alluvihealthcare.co
# Generate with: npm run hash-password -- "your-password"
# Paste it ESCAPED, exactly as printed: ADMIN_PASSWORD_HASH=\$2b\$12\$... (an unescaped $ is expanded away)
ADMIN_PASSWORD_HASH=
# 32+ random chars. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# --- Email (SMTP on the client's webmail) ---
SMTP_HOST=mail.alluvihealthcare.co
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@alluvihealthcare.co
SMTP_PASSWORD=
MAIL_FROM="Alluvi <info@alluvihealthcare.co>"
# Where new-order notifications go
ORDER_NOTIFY_EMAIL=info@alluvihealthcare.co

# --- Customer accounts ---
# Separate secret from the admin session (32+ chars)
CUSTOMER_SESSION_SECRET=

# --- Proxy ---
# How many proxies append to X-Forwarded-For in front of the app (1 = Apache/LiteSpeed; 2 behind Cloudflare)
TRUSTED_PROXY_HOPS=1

# --- Product image uploads (admin) ---
# Absolute path OUTSIDE the deploy dir so deploys never wipe it (Namecheap: /home/<cpuser>/alluvi-uploads).
# Empty = <project>/.uploads (local dev only).
UPLOADS_DIR=
